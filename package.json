{
	"name": "obsidian-share-to-save",
	"version": "2.0.2",
	"description": "Save shared web content to your Obsidian vault. Share URLs from mobile, download and save on desktop.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node -e \"const p=require('./package.json');const m=require('./manifest.json');m.version=p.version;require('fs').writeFileSync('./manifest.json',JSON.stringify(m,null,'\\t')+'\\n')\"",
		"lint": "eslint ."
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"share",
		"save",
		"web-clipper"
	],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "9.30.1",
		"@types/node": "^22.0.0",
		"@types/turndown": "^5.0.6",
		"esbuild": "0.25.5",
		"eslint-plugin-obsidianmd": "0.1.9",
		"globals": "14.0.0",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.35.1"
	},
	"dependencies": {
		"@joplin/turndown-plugin-gfm": "^1.0.67",
		"defuddle": "github:chenxiccc/defuddle#0e5bf20",
		"linkedom": "^0.18.0",
		"obsidian": "latest",
		"turndown": "^7.2.4"
	}
}
